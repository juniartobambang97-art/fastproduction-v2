<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>FastProduction — City of Fashion</title>
  
  <!-- Menggunakan Font Standar FastProduction V2 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  
  <style>
    /* =========================================
       DESIGN SYSTEM FASTPRODUCTION V2
       ========================================= */
    :root {
      --bg: #111412;
      --surface: #191e1a;
      --surface-2: #202720;
      --border: #303a31;
      --text: #f1f3ed;
      --muted: #929c91;
      --accent: #c6f36a;
      
      --font-main: 'Manrope', sans-serif;
      --font-mono: 'DM Mono', monospace;
    }

    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
      user-select: none; 
      -webkit-tap-highlight-color: transparent;
    }

    body, html {
      width: 100%; 
      height: 100dvh; 
      overflow: hidden;
      background-color: var(--bg);
      font-family: var(--font-main);
      color: var(--text);
    }

    /* =========================================
       CANVAS WORLD
       ========================================= */
    #game-world {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%; z-index: 1;
    }

    /* =========================================
       GLOBAL UI LAYER
       ========================================= */
    #ui-layer {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%; z-index: 10;
      pointer-events: none;
      display: flex; flex-direction: column;
      padding: 1.5rem;
    }

    /* =========================================
       1. INITIAL LOADING SCREEN
       ========================================= */
    #initial-loader {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      background: var(--bg); z-index: 100;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      transition: opacity 0.8s ease;
    }

    .loader-logo {
      font-family: var(--font-main);
      font-size: 2rem; font-weight: 800;
      color: var(--text); letter-spacing: 1px;
      margin-bottom: 24px; text-align: center;
    }
    
    .loader-logo span { color: var(--accent); }

    .loader-bar-container {
      width: 80%; max-width: 300px; height: 4px;
      background: var(--surface-2);
      border-radius: 2px; overflow: hidden;
      position: relative;
    }

    .loader-bar {
      width: 0%; height: 100%;
      background: var(--accent);
      transition: width 0.1s linear;
    }

    .loader-text {
      margin-top: 16px; font-family: var(--font-mono);
      font-size: 0.75rem; color: var(--muted);
      letter-spacing: 1px; text-align: center;
    }

    /* =========================================
       HEADER & STATUS
       ========================================= */
    .game-header {
      display: flex; flex-direction: column;
      gap: 4px; pointer-events: auto;
      opacity: 0; transition: opacity 1s;
    }

    .logo-container {
      font-family: var(--font-main);
      font-size: 1.5rem; font-weight: 800;
      letter-spacing: 0.5px;
      color: var(--text);
    }

    .logo-fast { color: var(--accent); }
    
    .world-title {
      font-family: var(--font-mono);
      font-size: 0.7rem; letter-spacing: 2px;
      color: var(--muted);
      border-left: 2px solid var(--accent);
      padding-left: 8px;
      margin-top: 4px;
      text-transform: uppercase;
    }

    .server-status {
      position: absolute; top: 1.5rem; right: 1.5rem;
      display: flex; align-items: center; gap: 8px;
      font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--muted);
      background: var(--surface);
      padding: 8px 12px;
      border: 1px solid var(--border);
      border-radius: 6px;
      opacity: 0; transition: opacity 1s;
    }

    .status-dot {
      width: 6px; height: 6px;
      background-color: var(--accent);
      border-radius: 50%;
      animation: pulse 2s infinite;
    }

    /* =========================================
       2. LOGIN PANEL
       ========================================= */
    .login-container {
      position: absolute; 
      top: 50%; left: 50%;
      transform: translate(-50%, -48%) scale(0.98);
      width: 90%; max-width: 380px; 
      pointer-events: auto;
      opacity: 0; 
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .login-container.show {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    .hud-panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px; 
      padding: 32px 28px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .panel-title {
      font-family: var(--font-main); font-size: 1.1rem;
      color: var(--text); text-align: center;
      margin-bottom: 24px; font-weight: 700;
    }

    .input-group { margin-bottom: 18px; }
    
    .input-group label {
      display: block; font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--muted); margin-bottom: 8px;
      text-transform: uppercase;
    }

    .input-group input {
      width: 100%; background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text); padding: 12px 14px;
      font-family: var(--font-main); font-size: 0.95rem;
      border-radius: 6px; outline: none; transition: 0.2s;
    }

    .input-group input:focus {
      border-color: var(--accent);
    }
    
    .input-group input::placeholder {
      color: #525a51;
    }

    .form-options {
      display: flex; justify-content: space-between;
      align-items: center; margin-bottom: 24px;
      font-size: 0.8rem;
    }

    .checkbox-container { display: flex; align-items: center; cursor: pointer; color: var(--muted); }
    .checkbox-container input { display: none; }
    
    .checkmark {
      width: 16px; height: 16px; border: 1px solid var(--border);
      border-radius: 4px; margin-right: 8px; display: flex;
      align-items: center; justify-content: center; transition: 0.2s;
      background: var(--bg);
    }
    
    .checkbox-container input:checked ~ .checkmark {
      background: var(--accent); border-color: var(--accent);
    }
    
    .checkbox-container input:checked ~ .checkmark::after {
      content: '✓'; color: var(--bg); font-weight: bold; font-size: 11px;
    }

    .forgot-link { 
      color: var(--muted); text-decoration: none; font-weight: 500; 
      transition: color 0.2s;
    }
    .forgot-link:hover { color: var(--accent); }

    .btn {
      width: 100%; padding: 12px; font-family: var(--font-main);
      font-size: 0.9rem; font-weight: 700;
      letter-spacing: 0.5px; border: none; border-radius: 6px;
      cursor: pointer; transition: 0.2s; position: relative;
      display: flex; justify-content: center; align-items: center; height: 44px;
    }

    .btn-primary {
      background: var(--accent); color: var(--bg);
      margin-bottom: 12px;
    }
    .btn-primary:hover { filter: brightness(1.1); }

    .btn-secondary { 
      background: transparent; 
      color: var(--text); 
      border: 1px solid var(--border); 
    }
    .btn-secondary:hover { background: var(--surface-2); }

    .spinner {
      display: none; width: 18px; height: 18px;
      border: 2px solid rgba(0,0,0,0.2); border-top-color: var(--bg);
      border-radius: 50%; animation: spin 1s linear infinite;
    }

    /* =========================================
       3. CHARACTER SELECTION SCREEN
       ========================================= */
    #character-select {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(17, 20, 18, 0.95); /* Overlay gelap sesuai bg */
      z-index: 50; display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity 0.6s ease;
      padding: 20px;
      backdrop-filter: blur(8px);
    }

    #character-select.active { opacity: 1; pointer-events: auto; }

    .char-select-title {
      font-family: var(--font-main); font-size: 1.2rem;
      color: var(--text); font-weight: 700;
      margin-bottom: 24px; text-align: center;
    }

    .character-card {
      display: flex; flex-direction: column;
      align-items: center; gap: 16px;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 32px 24px; border-radius: 12px;
      width: 100%; max-width: 320px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .character-avatar {
      width: 100px; height: 100px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 50%; display: flex;
      align-items: center; justify-content: center;
      font-size: 3rem; color: var(--accent);
    }

    .character-name {
      font-family: var(--font-main); font-size: 1.3rem;
      color: var(--text); font-weight: 700; text-align: center;
      word-break: break-all;
    }

    .character-role {
      font-family: var(--font-mono); font-size: 0.75rem; 
      color: var(--muted); letter-spacing: 1px;
    }

    .btn-enter-world {
      background: var(--accent); color: var(--bg);
      border: none;
      padding: 12px 30px; font-family: var(--font-main);
      font-weight: 700; font-size: 0.95rem; 
      margin-top: 16px; cursor: pointer;
      transition: 0.2s; border-radius: 6px; width: 100%;
    }
    
    .btn-enter-world:hover {
      filter: brightness(1.1);
    }

    /* ANIMATIONS */
    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.4; } 100% { opacity: 1; } }
    @keyframes spin { 100% { transform: rotate(360deg); } }

    /* =========================================
       DESKTOP LAYOUT (Min-width 768px)
       ========================================= */
    @media (min-width: 768px) {
      #ui-layer { padding: 2.5rem; }
      
      .game-header { gap: 6px; }
      .logo-container { font-size: 2.2rem; }
      .world-title { font-size: 0.8rem; letter-spacing: 3px; }
      
      .server-status {
        top: 2.5rem; right: 2.5rem;
        gap: 10px; font-size: 0.75rem; padding: 10px 16px;
      }

      .login-container { width: 400px; }
      .hud-panel { padding: 40px; }
      .panel-title { font-size: 1.25rem; margin-bottom: 28px; }
      
      .input-group { margin-bottom: 20px; }
      .btn { height: 48px; font-size: 1rem; }

      .char-select-title { font-size: 1.5rem; margin-bottom: 32px; }
      .character-card { padding: 40px; width: auto; min-width: 340px; }
      .character-avatar { width: 120px; height: 120px; font-size: 4rem; }
      .character-name { font-size: 1.6rem; }
      .character-role { font-size: 0.85rem; }
      .btn-enter-world { padding: 14px 40px; font-size: 1.05rem; }
    }
  </style>
</head>
<body>

  <!-- 1. INITIAL LOADING SCREEN -->
  <div id="initial-loader">
    <div class="loader-logo">FAST<span>PRODUCTION</span></div>
    <div class="loader-bar-container">
      <div class="loader-bar" id="loadProgress"></div>
    </div>
    <div class="loader-text" id="loadText">CONNECTING TO SERVER...</div>
  </div>

  <!-- CANVAS WORLD -->
  <canvas id="game-world"></canvas>

  <!-- MAIN UI -->
  <div id="ui-layer" style="display: none;">
    
    <!-- Header -->
    <div class="game-header" id="mainHeader">
      <div class="logo-container">
        <span class="logo-fast">FAST</span>PRODUCTION
      </div>
      <div class="world-title">CITY OF FASHION</div>
    </div>

    <!-- Server Status -->
    <div class="server-status" id="mainStatus">
      <div class="status-dot"></div>
      <span>ONLINE | 24ms</span>
    </div>

    <!-- LOGIN PANEL -->
    <div class="login-container" id="login-panel">
      <div class="hud-panel">
        <div class="panel-title">System Login</div>
        
        <form id="loginForm">
          <div class="input-group">
            <label for="email">Identity (Email)</label>
            <input type="email" id="email" placeholder="Enter your email" required autocomplete="email">
          </div>
          
          <div class="input-group">
            <label for="password">Passcode</label>
            <input type="password" id="password" placeholder="Enter your password" required autocomplete="current-password">
          </div>

          <div class="form-options">
            <label class="checkbox-container">
              <input type="checkbox" id="remember">
              <span class="checkmark"></span>
              Remember Access
            </label>
            <a href="#" class="forgot-link">Recover?</a>
          </div>

          <button type="submit" class="btn btn-primary" id="btnLogin">
            <span class="btn-text">INITIALIZE LOGIN</span>
            <div class="spinner" id="loginSpinner"></div>
          </button>
          
          <button type="button" class="btn btn-secondary" id="btnRegister">
            Create New Identity
          </button>
        </form>
      </div>
    </div>

  </div>

  <!-- 3. CHARACTER SELECTION SCREEN -->
  <div id="character-select">
    <div class="char-select-title">Select Your Identity</div>
    
    <div class="character-card">
      <div class="character-avatar">&#128100;</div>
      <div class="character-name" id="charName">Fashion Architect</div>
      <div class="character-role">MANUFACTURER / LEVEL 1</div>
      
      <button class="btn-enter-world" id="btnEnterWorld">ENTER WORLD</button>
    </div>
  </div>

  <script>
    /**
     * =========================================
     * 1. CANVAS WORLD ENGINE (Industrial Dark Green)
     * =========================================
     */
    const canvas = document.getElementById('game-world');
    const ctx = canvas.getContext('2d');
    
    let width, height;
    let camera = { x: 0, y: 0, targetX: 0, targetY: 0 };
    
    let scale = 1;
    const BASE_TILE_W = 64;
    const BASE_TILE_H = 32;

    function getTileW() { return BASE_TILE_W * scale; }
    function getTileH() { return BASE_TILE_H * scale; }
    
    const ORIGIN_X = () => width / 2;
    const ORIGIN_Y = () => height / 2 - 100;

    const buildings = [];
    const npcs = [];
    const vehicles = [];
    const particles = [];

    // Palet warna disesuaikan dengan Design System V2
    const colors = {
      bgTop: '#111412',
      bgBottom: '#0a0d0b',
      grid: 'rgba(198, 243, 106, 0.03)', // Accent (Lime) transparan
      buildingBase: '#191e1a',           // Surface
      buildingTop: '#202720',            // Surface 2
      buildingStroke: '#303a31',         // Border
      buildingDetail: '#111412',         // Bg
      windowAccent: '#c6f36a',           // Accent
      vehicle: '#929c91',
      text: '#f1f3ed',
      text: '#f1f3ed',                // Muted
    };

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      
      if (width < 768) {
        scale = 0.65; 
      } else {
        scale = 1;
      }
    }
    window.addEventListener('resize', resize);
    resize();

    function project(x, y, z) {
      const tw = getTileW();
      const th = getTileH();
      return {
        x: ORIGIN_X() + (x - y) * (tw / 2) - camera.x,
        y: ORIGIN_Y() + (x + y) * (th / 2) - (z * th) - camera.y
      };
    }

    function initCity() {
      buildings.length = 0; npcs.length = 0; vehicles.length = 0;
      
      for (let x = -10; x <= 10; x++) {
        for (let y = -10; y <= 10; y++) {
          if (x % 4 === 0 || y % 4 === 0) continue; 
          if (Math.random() > 0.75) continue;

          const heightZ = Math.floor(Math.random() * 5) + 2;
          buildings.push({
            x: x * 2, y: y * 2, z: heightZ,
            type: Math.random() > 0.8 ? 'factory' : 'shop',
            pulse: Math.random() * Math.PI * 2, speed: 0.005 + Math.random() * 0.01 // Animasi lebih tenang
          });
        }
      }

      for(let i=0; i<20; i++) {
        let npc = { x: (Math.random() - 0.5) * 30, y: (Math.random() - 0.5) * 30, targetX: 0, targetY: 0, speed: 0.02 + Math.random() * 0.03, color: `rgba(198, 243, 106, ${Math.random() * 0.5 + 0.3})` }; // NPC warna lime pudar
        resetNpcTarget(npc); npcs.push(npc);
      }

      for(let i=0; i<8; i++) {
        vehicles.push({ x: (Math.random() - 0.5) * 20, y: (Math.random() - 0.5) * 20, dir: Math.random() * Math.PI * 2, speed: 0.05 + Math.random() * 0.1 });
      }
    }

    function resetNpcTarget(npc) {
      npc.targetX = (Math.random() - 0.5) * 30;
      npc.targetY = (Math.random() - 0.5) * 30;
    }

    function drawGrid() {
      ctx.strokeStyle = colors.grid; ctx.lineWidth = 1 * scale; const extent = 30;
      for (let i = -extent; i <= extent; i++) {
        let p1 = project(i, -extent, 0); let p2 = project(i, extent, 0);
        ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
        let p3 = project(-extent, i, 0); let p4 = project(extent, i, 0);
        ctx.beginPath(); ctx.moveTo(p3.x, p3.y); ctx.lineTo(p4.x, p4.y); ctx.stroke();
      }
    }

    function drawBuilding(b) {
      const base = project(b.x, b.y, 0);
      const tw = getTileW(); const th = getTileH();
      const w = tw * 0.8; const h = th * 0.8; const bh = (b.z * th) * 0.9;

      // Sisi Kiri
      ctx.fillStyle = colors.buildingBase;
      ctx.beginPath(); ctx.moveTo(base.x - w/2, base.y); ctx.lineTo(base.x, base.y + h/2); ctx.lineTo(base.x, base.y + h/2 - bh); ctx.lineTo(base.x - w/2, base.y - bh); ctx.fill();
      ctx.strokeStyle = colors.buildingDetail; ctx.lineWidth = 1 * scale; ctx.stroke();

      // Sisi Kanan
      ctx.fillStyle = colors.buildingTop;
      ctx.beginPath(); ctx.moveTo(base.x, base.y + h/2); ctx.lineTo(base.x + w/2, base.y); ctx.lineTo(base.x + w/2, base.y - bh); ctx.lineTo(base.x, base.y + h/2 - bh); ctx.fill();
      ctx.strokeStyle = colors.buildingDetail; ctx.stroke();

      // Atap
      ctx.fillStyle = colors.buildingBase;
      ctx.beginPath(); ctx.moveTo(base.x - w/2, base.y - bh); ctx.lineTo(base.x, base.y + h/2 - bh); ctx.lineTo(base.x + w/2, base.y - bh); ctx.lineTo(base.x, base.y - h/2 - bh); ctx.fill();

      // Lampu Jendela (Lebih natural, tidak glow berlebihan)
      const pulse = (Math.sin(Date.now() * b.speed + b.pulse) + 1) / 2;
      ctx.strokeStyle = b.type === 'factory' ? `rgba(198, 243, 106, ${0.2 + pulse * 0.3})` : colors.buildingStroke;
      ctx.lineWidth = 2 * scale;
      
      ctx.beginPath(); ctx.moveTo(base.x - w/4, base.y + h/4); ctx.lineTo(base.x - w/4, base.y + h/4 - bh); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(base.x + w/4, base.y + h/4); ctx.lineTo(base.x + w/4, base.y + h/4 - bh); ctx.stroke();
    }

    function drawVehicle(v) {
      const p = project(v.x, v.y, 0.1);
      const s = scale; 
      
      ctx.fillStyle = colors.vehicle; 
      ctx.beginPath(); ctx.ellipse(p.x, p.y, 14 * s, 7 * s, Math.PI/4, 0, Math.PI*2); ctx.fill();
      
      ctx.fillStyle = colors.windowAccent; 
      ctx.beginPath(); ctx.arc(p.x + Math.cos(v.dir)*10*s, p.y + Math.sin(v.dir)*5*s, 2 * s, 0, Math.PI*2); ctx.fill();
    }

    function drawNPC(n) {
      const p = project(n.x, n.y, 0.3);
      const s = scale;
      ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(p.x, p.y, 6 * s, 3 * s, 0, 0, Math.PI*2); ctx.fill();
      
      ctx.fillStyle = n.color; ctx.beginPath(); ctx.arc(p.x, p.y - 10 * s, 4 * s, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = colors.text; ctx.beginPath(); ctx.arc(p.x, p.y - 16 * s, 3 * s, 0, Math.PI*2); ctx.fill();
      
      ctx.strokeStyle = n.color; ctx.lineWidth = 1 * s; ctx.beginPath(); ctx.arc(p.x, p.y - 10 * s, 8 * s, 0, Math.PI*2); ctx.stroke();
    }

    function update() {
      const time = Date.now() * 0.0005;
      camera.x = Math.sin(time) * 30; camera.y = Math.cos(time * 0.8) * 15;

      npcs.forEach(n => {
        const dx = n.targetX - n.x; const dy = n.targetY - n.y; const dist = Math.hypot(dx, dy);
        if (dist < 0.5) resetNpcTarget(n);
        else { n.x += (dx / dist) * n.speed; n.y += (dy / dist) * n.speed; }
      });

      vehicles.forEach(v => {
        v.x += Math.cos(v.dir) * v.speed; v.y += Math.sin(v.dir) * v.speed;
        if (Math.abs(v.x) > 25 || Math.abs(v.y) > 25) { v.dir += Math.PI; v.x += Math.cos(v.dir) * v.speed; v.y += Math.sin(v.dir) * v.speed; }
      });

      if (Math.random() < 0.1) { // Partikel lebih sedikit
        particles.push({ x: Math.random() * width, y: Math.random() * height, vx: (Math.random() - 0.5) * 0.5, vy: -0.5 - Math.random() * 0.5, life: 1, decay: 0.01 + Math.random() * 0.02 });
      }
      for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i]; p.x += p.vx; p.y += p.vy; p.life -= p.decay;
        if (p.life <= 0) particles.splice(i, 1);
      }
    }

    function render() {
      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
      bgGrad.addColorStop(0, colors.bgTop); bgGrad.addColorStop(1, colors.bgBottom);
      ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, width, height);

      drawGrid();

      const renderables = [...buildings, ...vehicles].sort((a, b) => (a.x + a.y) - (b.x + b.y));
      renderables.forEach(item => item.type ? drawBuilding(item) : drawVehicle(item));

      npcs.sort((a, b) => (a.x + a.y) - (b.x + b.y));
      npcs.forEach(drawNPC);

      ctx.fillStyle = colors.windowAccent;
      particles.forEach(p => { ctx.globalAlpha = p.life * 0.5; ctx.beginPath(); ctx.arc(p.x, p.y, 1.5 * scale, 0, Math.PI*2); ctx.fill(); });
      ctx.globalAlpha = 1.0;

      // Vignette (lebih halus agar tidak terlalu gelap)
      const vig = ctx.createRadialGradient(width/2, height/2, height*0.3, width/2, height/2, height);
      vig.addColorStop(0, 'rgba(17,20,18,0)'); vig.addColorStop(1, 'rgba(17,20,18,0.8)');
      ctx.fillStyle = vig; ctx.fillRect(0, 0, width, height);
    }

    function gameLoop() { update(); render(); requestAnimationFrame(gameLoop); }
    
    initCity(); gameLoop();

    /**
     * =========================================
     * 2. GAME UI FLOW LOGIC (Tetap Sama)
     * =========================================
     */
    const initialLoader = document.getElementById('initial-loader');
    const loadProgress = document.getElementById('loadProgress');
    const loadText = document.getElementById('loadText');
    const uiLayer = document.getElementById('ui-layer');
    const loginPanel = document.getElementById('login-panel');
    const mainHeader = document.getElementById('mainHeader');
    const mainStatus = document.getElementById('mainStatus');
    const charSelectScreen = document.getElementById('character-select');
    const loginForm = document.getElementById('loginForm');
    const btnLogin = document.getElementById('btnLogin');
    const loginSpinner = document.getElementById('loginSpinner');
    const btnText = btnLogin.querySelector('.btn-text');
    const charName = document.getElementById('charName');

    // FASE 1: INITIAL LOADING
    let progress = 0;
    const loadInterval = setInterval(() => {
      progress += Math.random() * 15;
      if (progress >= 100) {
        progress = 100;
        clearInterval(loadInterval);
        
        loadText.textContent = "CONNECTION ESTABLISHED";
        loadText.style.color = "var(--text)";
        
        setTimeout(() => {
          initialLoader.style.opacity = '0';
          setTimeout(() => {
            initialLoader.style.display = 'none';
            uiLayer.style.display = 'flex';
            
            setTimeout(() => {
              mainHeader.style.opacity = '1';
              mainStatus.style.opacity = '1';
              loginPanel.classList.add('show');
            }, 100);
            
          }, 800);
        }, 400);
      }
      loadProgress.style.width = progress + '%';
      
      if (progress > 30 && progress < 60) loadText.textContent = "LOADING WORLD ASSETS...";
      if (progress > 60 && progress < 90) loadText.textContent = "SYNCHRONIZING IDENTITY...";
      
    }, 150);

    // FASE 2: SUPABASE AUTH

    function setLoginLoading(loading) {
      btnLogin.disabled = loading;
      btnText.style.display = loading ? 'none' : 'inline';
      loginSpinner.style.display = loading ? 'block' : 'none';
    }

    function showCharacter(user) {
      const metadata = user.user_metadata || {};
      const name =
        metadata.full_name ||
        user.email?.split('@')[0] ||
        'Fashion Architect';

      charName.textContent = name;
      try {
        sessionStorage.setItem('fp_character_name', name);
      } catch (_) {}

      loginPanel.classList.remove('show');

      setTimeout(() => {
        uiLayer.style.opacity = '0';
        charSelectScreen.classList.add('active');
      }, 500);
    }

    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      if (!email || !password) return;

      if (!window.FPAuth) {
        alert('Supabase belum berhasil dimuat. Coba refresh halaman.');
        return;
      }

      setLoginLoading(true);

      try {
        const data = await window.FPAuth.login(email, password);
        showCharacter(data.user);
      } catch (error) {
        alert('Login gagal: ' + error.message);
      } finally {
        setLoginLoading(false);
      }
    });

    // REGISTRASI
    document.getElementById('btnRegister').addEventListener('click', async () => {
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      if (!email || !password) {
        alert('Isi email dan password terlebih dahulu untuk membuat akun.');
        return;
      }

      if (password.length < 6) {
        alert('Password minimal 6 karakter.');
        return;
      }

      const fullName = email.split('@')[0];

      try {
        const data = await window.FPAuth.register({
          email,
          password,
          fullName,
          phone: ''
        });

        if (data.session && data.user) {
          alert('Registrasi berhasil. Selamat datang!');
          showCharacter(data.user);
        } else {
          alert('Registrasi berhasil. Silakan periksa email untuk verifikasi akun sebelum login.');
        }
      } catch (error) {
        alert('Registrasi gagal: ' + error.message);
      }
    });

    // PEMULIHAN PASSWORD
    document.querySelector('.forgot-link').addEventListener('click', async (e) => {
      e.preventDefault();

      const email = document.getElementById('email').value.trim();

      if (!email) {
        alert('Masukkan email terlebih dahulu.');
        return;
      }

      try {
        const { error } = await window.fpSupabase.auth.resetPasswordForEmail(email, {
          redirectTo: window.location.origin + '/login.html'
        });

        if (error) throw error;

        alert('Jika email terdaftar, tautan pemulihan password akan dikirim ke email tersebut.');
      } catch (error) {
        alert('Gagal mengirim pemulihan password: ' + error.message);
      }
    });

    // FASE 3: ENTER WORLD
    const btnEnterWorld = document.getElementById('btnEnterWorld');
    btnEnterWorld.addEventListener('click', () => {
      btnEnterWorld.textContent = 'LOADING WORLD...';
      
      const flash = document.createElement('div');
      flash.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:#111412;z-index:999;opacity:0;transition:opacity 0.5s;pointer-events:none;'; // Warna flash disesuaikan
      document.body.appendChild(flash);
      
      setTimeout(() => { flash.style.opacity = '1'; }, 50);

      // Redirect diperbaiki ke /dashboard
      setTimeout(() => {
        window.location.href = '/dashboard.html'; 
      }, 1000);
    });

  </script>

